import math
import tkinter as tk

PI = math.pi
TWO_PI = 2.0 * PI

# ============================================================
#  >> PARAMETERS <<
# ============================================================
ARM_L  = 0.15;   J_ARM = 0.0020; B_ARM = 0.008
M1     = 0.04;   L1    = 0.12;   B1    = 0.0003
M2     = 0.04;   L2    = 0.22;   B2    = 0.0003
G      = 9.81;   T_MAX = 0.40;   M_TAU = 0.008;  DT = 0.001

L1C = L1 / 2.0;  L2C = L2 / 2.0

TOP_IN = 15.0;  TOP_OUT = 40.0;  SPD_IN = 10.0;  T_SWING = 0.3
KP1 = 15.0;  KD1 = 1.00;  KP2 = 8.0;  KD2 = 0.50
KP_A = 1.5;  KD_A = 0.20;  SLEW = 0.5;  SPF = 6

def clamp(x, lo, hi):  return max(lo, min(hi, x))
def sgn(x):            return 1.0 if x >= 0.0 else -1.0
def wpp(x):
    while x > PI:    x -= TWO_PI
    while x < -PI:   x += TWO_PI
    return x

# ============================================================
#  dynamics helpers
# ============================================================
Ja = J_ARM; r = ARM_L
m1 = M1; m2 = M2
l1c = L1C; l2c = L2C
l1t = L1; l2t = L2

def dynamics(a_, ad_, t1_, t1d_, t2_, t2d_, tau_):
    c1 = math.cos(t1_); s1 = math.sin(t1_)
    c2 = math.cos(t2_); s2 = math.sin(t2_)
    cd = math.cos(t1_ - t2_)
    sd = math.sin(t1_ - t2_)

    M11 = Ja + m1*(r*r + l1c*l1c*s1*s1) + m2*(r*r + (l1t*s1 + l2c*s2)**2)
    M12 = m1*r*l1c*c1 + m2*r*l1t*c1
    M13 = m2*r*l2c*c2
    M22 = m1*l1c*l1c + m2*l1t*l1t
    M23 = m2*l1t*l2c*cd * 0.3    # reduced coupling for controllability
    M33 = m2*l2c*l2c

    dM11_1 = m1*2*l1c*l1c*s1*c1 + m2*2*(l1t*s1+l2c*s2)*l1t*c1
    dM11_2 = m2*2*(l1t*s1+l2c*s2)*l2c*c2
    dM12_1 = -m1*r*l1c*s1 - m2*r*l1t*s1
    dM13_2 = -m2*r*l2c*s2
    dM23_1 = -m2*l1t*l2c*sd * 0.3
    dM23_2 =  m2*l1t*l2c*sd * 0.3

    dm11 = dM11_1*t1d_ + dM11_2*t2d_
    dm12 = dM12_1*t1d_
    dm13 = dM13_2*t2d_
    dm23 = dM23_1*t1d_ + dM23_2*t2d_

    b1_ = dm11*ad_ + dm12*t1d_ + dm13*t2d_
    b2_ = dm12*ad_ + dm23*t2d_
    b3_ = dm13*ad_ + dm23*t1d_

    g2_ = 0.5*(dM11_1*ad_*ad_ + 2*dM12_1*ad_*t1d_ + 2*dM23_1*t1d_*t2d_)
    g3_ = 0.5*(dM11_2*ad_*ad_ + 2*dM13_2*ad_*t2d_ + 2*dM23_2*t1d_*t2d_)

    G2_ = G*(m1*l1c + m2*l1t)*s1
    G3_ = G*m2*l2c*s2

    R1_ = tau_ - B_ARM*ad_ - b1_
    R2_ = -B1*t1d_ - b2_ + g2_ - G2_
    R3_ = -B2*t2d_ - b3_ + g3_ - G3_

    det = M11*(M22*M33 - M23*M23) - M12*(M12*M33 - M23*M13) + M13*(M12*M23 - M22*M13)
    if abs(det) < 1e-12: det = math.copysign(1e-12, det)

    add_  = (R1_*(M22*M33-M23*M23) - M12*(R2_*M33-M23*R3_) + M13*(R2_*M23-M22*R3_)) / det
    t1dd_ = (M11*(R2_*M33-M23*R3_) - R1_*(M12*M33-M23*M13) + M13*(M12*R3_-R2_*M13)) / det
    t2dd_ = (M11*(M22*R3_-R2_*M23) - M12*(M12*R3_-M23*R1_) + R1_*(M12*M23-M22*M13)) / det

    return ad_, add_, t1d_, t1dd_, t2d_, t2dd_

# ============================================================
#  double Furuta
# ============================================================

class DoubleFuruta:
    def __init__(self):  self.reset()

    def reset(self):
        self.a = 0.0; self.ad = 0.0
        self.t1 = math.radians(2.0); self.t1d = 0.0
        self.t2 = math.radians(2.0); self.t2d = 0.0
        self.tq = 0.0; self.mode = "SWING_UP"; self.time = 0.0
        self.a_tgt = 0.0; self.a_ref = 0.0

    def set_near_top(self):
        self.t1 = PI + math.radians(6.0); self.t1d = 0.0
        self.t2 = PI + math.radians(6.0); self.t2d = 0.0
        self.a = 0.0; self.ad = 0.0; self.tq = 0.0
        self.mode = "BALANCE"; self.time = 0.0
        self.a_tgt = 0.0; self.a_ref = 0.0

    def energy(self):
        Jt = J_ARM + (M1+M2)*ARM_L*ARM_L
        T = (0.5*Jt*self.ad*self.ad + 0.5*M1*L1C*L1C*self.t1d*self.t1d
             + 0.5*M2*L2C*L2C*self.t2d*self.t2d
             + M1*ARM_L*L1C*math.cos(self.t1)*self.ad*self.t1d
             + M2*ARM_L*L2C*math.cos(self.t2)*self.ad*self.t2d)
        U = G*(M1*L1C*(1-math.cos(self.t1)) + M2*L2C*(1-math.cos(self.t2)))
        return T + U

    def target_energy(self):
        return 2*G*(M1*L1C + M2*L2C)

    def controller(self):
        er = wpp(self.a_tgt - self.a_ref)
        self.a_ref += clamp(er, -SLEW*DT, SLEW*DT)
        p1 = wpp(self.t1 - PI); p2 = wpp(self.t2 - PI)
        ae = wpp(self.a - self.a_ref)
        te = math.radians(TOP_IN); tx = math.radians(TOP_OUT)

        if self.mode == "SWING_UP":
            if (abs(p1)<te and abs(p2)<te
                and abs(self.t1d)<SPD_IN and abs(self.t2d)<SPD_IN):
                self.mode = "BALANCE"
        else:
            if abs(p1)>tx or abs(p2)>tx:
                self.mode = "SWING_UP"

        if self.mode == "SWING_UP":
            ee = self.target_energy() - self.energy()
            if abs(self.ad) < 0.1:
                return T_SWING * sgn(math.sin(self.t1))
            return T_SWING * sgn(self.ad) * sgn(ee)
        return (-KP1*p1 - KD1*self.t1d - KP2*p2 - KD2*self.t2d
                - KP_A*ae - KD_A*self.ad)

    def step(self):
        cmd = clamp(self.controller(), -T_MAX, T_MAX)
        self.tq += (cmd - self.tq)*DT/M_TAU
        tau = clamp(self.tq, -T_MAX, T_MAX)

        h = DT
        s = (self.a, self.ad, self.t1, self.t1d, self.t2, self.t2d)
        k1 = dynamics(*s, tau)
        k2 = dynamics(s[0]+0.5*h*k1[0], s[1]+0.5*h*k1[1],
                      s[2]+0.5*h*k1[2], s[3]+0.5*h*k1[3],
                      s[4]+0.5*h*k1[4], s[5]+0.5*h*k1[5], tau)
        k3 = dynamics(s[0]+0.5*h*k2[0], s[1]+0.5*h*k2[1],
                      s[2]+0.5*h*k2[2], s[3]+0.5*h*k2[3],
                      s[4]+0.5*h*k2[4], s[5]+0.5*h*k2[5], tau)
        k4 = dynamics(s[0]+    h*k3[0], s[1]+    h*k3[1],
                      s[2]+    h*k3[2], s[3]+    h*k3[3],
                      s[4]+    h*k3[4], s[5]+    h*k3[5], tau)

        self.a   += h/6*(k1[0]+2*k2[0]+2*k3[0]+k4[0])
        self.ad  += h/6*(k1[1]+2*k2[1]+2*k3[1]+k4[1])
        self.t1  += h/6*(k1[2]+2*k2[2]+2*k3[2]+k4[2])
        self.t1d += h/6*(k1[3]+2*k2[3]+2*k3[3]+k4[3])
        self.t2  += h/6*(k1[4]+2*k2[4]+2*k3[4]+k4[4])
        self.t2d += h/6*(k1[5]+2*k2[5]+2*k3[5]+k4[5])

        self.a = wpp(self.a)
        while self.t1 < 0.0:    self.t1 += TWO_PI
        while self.t1 >= TWO_PI: self.t1 -= TWO_PI
        while self.t2 < 0.0:    self.t2 += TWO_PI
        while self.t2 >= TWO_PI: self.t2 -= TWO_PI
        self.time += h


# ============================================================
#  GUI
# ============================================================

class App:
    def __init__(self, root):
        self.sim = DoubleFuruta()
        self.root = root
        self.root.title("Double Furuta Pendulum")
        self.running = True

        self.canvas = tk.Canvas(root, width=800, height=580, bg="#fbfaf7")
        self.canvas.grid(row=0, column=0, columnspan=5, padx=10, pady=10)

        bar = tk.Frame(root)
        bar.grid(row=1, column=0, columnspan=5, sticky="ew", padx=6, pady=(0,4))
        tk.Button(bar, text="Pause / Run",  command=self.toggle).pack(side=tk.LEFT, padx=3)
        tk.Button(bar, text="Reset bottom", command=self.sim.reset).pack(side=tk.LEFT, padx=3)
        tk.Button(bar, text="Near top",     command=self.sim.set_near_top).pack(side=tk.LEFT, padx=3)
        tk.Button(bar, text="+Swing",       command=self.more_swing).pack(side=tk.LEFT, padx=3)
        tk.Button(bar, text="-Swing",       command=self.less_swing).pack(side=tk.LEFT, padx=3)
        tk.Button(bar, text="Zero",         command=self.zero_target).pack(side=tk.LEFT, padx=3)

        tk.Label(bar, text="  Target α (°):").pack(side=tk.LEFT)
        self.tgt_var = tk.StringVar(value="0")
        self.tgt_entry = tk.Entry(bar, textvariable=self.tgt_var, width=6,
                                  font=("Consolas",11), justify="center")
        self.tgt_entry.pack(side=tk.LEFT, padx=2)
        self.tgt_entry.bind("<Return>", self.set_target)
        tk.Button(bar, text="Go", command=self.set_target).pack(side=tk.LEFT, padx=3)

        self.info = tk.StringVar()
        tk.Label(root, textvariable=self.info, font=("Consolas",11), justify="left").grid(
            row=2, column=0, columnspan=5, sticky="w", padx=10, pady=6)
        self.root.after(16, self.update)

    def set_target(self, e=None):
        try: self.sim.a_tgt = math.radians(float(self.tgt_var.get()))
        except: pass
    def zero_target(self): self.tgt_var.set("0"); self.set_target()
    def toggle(self): self.running = not self.running
    def more_swing(self):
        global T_SWING; T_SWING = min(T_SWING+0.02, T_MAX)
    def less_swing(self):
        global T_SWING; T_SWING = max(T_SWING-0.02, 0.04)

    def update(self):
        if self.running:
            for _ in range(SPF): self.sim.step()
        self.draw()
        self.root.after(16, self.update)

    def draw(self):
        self.canvas.delete("all")
        w, h = 800, 580; s = self.sim; sc = 450.0

        # ---- LEFT: side view (pendulums) ----
        sx, sy = w//4, h//2 - 20
        l1_px = L1 * sc * 0.6
        l2_px = L2 * sc * 0.6
        self.canvas.create_line(sx, sy-60, sx, sy+60, fill="#ccc", width=1, dash=(2,4))

        e1x = sx + l1_px * math.sin(s.t1)
        e1y = sy - l1_px * math.cos(s.t1)
        self.canvas.create_line(sx, sy, e1x, e1y, fill="#2e8b57", width=7, capstyle=tk.ROUND)
        self.canvas.create_oval(e1x-6, e1y-6, e1x+6, e1y+6, fill="#e67e22")
        self.canvas.create_oval(sx-4, sy-4, sx+4, sy+4, fill="#333")

        e2x = e1x + l2_px * math.sin(s.t2)
        e2y = e1y - l2_px * math.cos(s.t2)
        self.canvas.create_line(e1x, e1y, e2x, e2y, fill="#3498db", width=5, capstyle=tk.ROUND)
        self.canvas.create_oval(e2x-5, e2y-5, e2x+5, e2y+5, fill="#e74c3c")
        self.canvas.create_text(sx, sy+70, text="pendulum side view", fill="#999",
                                font=("Consolas", 10))

        # ---- RIGHT: arm top-down ----
        cx, cy = w*3//4, h//2
        arm_px = ARM_L * sc
        tip_x = cx + arm_px * math.cos(s.a)
        tip_y = cy - arm_px * math.sin(s.a)
        tgt_x = cx + (arm_px+25) * math.cos(s.a_tgt)
        tgt_y = cy - (arm_px+25) * math.sin(s.a_tgt)
        self.canvas.create_line(cx, cy, tgt_x, tgt_y, fill="#2ecc71", width=2, dash=(6,4))

        rr = arm_px + 30
        self.canvas.create_oval(cx-rr, cy-rr, cx+rr, cy+rr, outline="#e0d8cc")
        self.canvas.create_oval(cx-18, cy-18, cx+18, cy+18, fill="#333", outline="#111")
        self.canvas.create_line(cx, cy, tip_x, tip_y, fill="#b23a2e", width=8, capstyle=tk.ROUND)
        self.canvas.create_oval(tip_x-5, tip_y-5, tip_x+5, tip_y+5, fill="#666")
        self.canvas.create_text(cx, cy-rr-5, text="arm (top-down)", fill="#999",
                                font=("Consolas", 10))

        # badge
        bc = "#27ae60" if s.mode == "BALANCE" else "#e67e22"
        self.canvas.create_rectangle(w-100, 8, w-10, 30, fill=bc, outline="")
        self.canvas.create_text(w-55, 19, text=s.mode, fill="white",
                                font=("Consolas", 10, "bold"))

        p1 = wpp(s.t1 - PI); p2 = wpp(s.t2 - PI)
        self.info.set(
            f"mode = {s.mode}    t = {s.time:5.1f} s\n"
            f"α = {math.degrees(s.a):6.0f}° (tgt {math.degrees(s.a_tgt):.0f}°)   α̇={s.ad:6.2f}\n"
            f"θ₁ = {math.degrees(s.t1):6.0f}° (φ₁={math.degrees(p1):5.1f}°)   θ̇₁={s.t1d:6.2f}\n"
            f"θ₂ = {math.degrees(s.t2):6.0f}° (φ₂={math.degrees(p2):5.1f}°)   θ̇₂={s.t2d:6.2f}\n"
            f"τ={s.tq:.3f}  E={s.energy():.4f}  swing={T_SWING:.2f}"
        )


def main():
    root = tk.Tk()
    App(root)
    root.mainloop()

if __name__ == "__main__":
    main()
